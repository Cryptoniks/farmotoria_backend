# Образ бэкенда для Render (Runtime: Docker, Dockerfile Path: ./Dockerfile.render)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=farmotoria_backend.settings.prod

WORKDIR /app

# psycopg2-binary не требует компилятора и libpq-dev
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

# Статика (админка, Swagger) собирается при сборке образа.
# Настоящие SECRET_KEY и DATABASE_URL здесь не нужны — подставляем заглушки.
RUN SECRET_KEY=build-only DATABASE_URL=sqlite:////tmp/build.sqlite3 \
    python manage.py collectstatic --noinput

RUN useradd --uid 1000 --create-home appuser && chown -R appuser /app
USER appuser

# Render передаёт порт в $PORT. Миграции и справочники идемпотентны,
# поэтому выполняются при каждом старте.
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py seed_game_data && exec gunicorn farmotoria_backend.wsgi:application --bind 0.0.0.0:${PORT:-10000} --workers 2 --threads 4 --timeout 60 --access-logfile -"]
