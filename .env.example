# Скопируйте в farmotoria_backend/.env для локальной разработки.
# На Render эти же переменные задаются в Dashboard → Environment (или через render.yaml).

# Секретный ключ Django. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Строка подключения Neon: Dashboard → Connect → Connection string (лучше pooled, с -pooler в адресе).
# Если не задана, локально используется SQLite (db.sqlite3).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Домены бэкенда через запятую (адрес Render добавляется автоматически)
ALLOWED_HOSTS=localhost,127.0.0.1

# Адреса фронтенда (Vercel) через запятую
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Превью-деплои Vercel (необязательно):
# CORS_ALLOWED_ORIGIN_REGEXES=^https://farmotoria-.*\.vercel\.app$

# Только для prod-настроек
# DEBUG=False
# SECURE_HSTS_SECONDS=31536000
