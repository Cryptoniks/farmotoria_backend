# Django - Production Configuration
# ВНИМАНИЕ: Этот файл НЕ должен попадать в git!
# Создайте свой .env на основе .env.example

# Django
SECRET_KEY=your-secret-key-here-use-django-admin-secretkey
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,production-server-ip

# Database - PostgreSQL
DB_NAME=farmotoria_db
DB_USER=farmotoria_user
DB_PASSWORD=your-strong-database-password-here
DB_HOST=db.your-domain.com
DB_PORT=5432

# CORS - разрешённые домены фронтенда
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Redis (для кэша и сессий) - опционально
REDIS_HOST=redis.your-domain.com
REDIS_PORT=6379

# Sentry (для мониторинга ошибок) - опционально
SENTRY_DSN=https-your-sentry-dsn-here

# Email (для восстановления пароля) - опционально
EMAIL_HOST=smtp.your-domain.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@your-domain.com
EMAIL_HOST_PASSWORD=your-email-password
